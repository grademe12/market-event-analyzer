# Required provider credential.
OPENDART_API_KEY=

# Assessment backend: claude (default) or kiro.
MARKET_EVENT_ASSESSOR=claude
# Claude Code CLI uses its own login (claude /login); no API key here.
# Use an absolute path for systemd if claude is not on the service PATH.
CLAUDE_CLI_PATH=claude
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_SECONDS=60

# Only for MARKET_EVENT_ASSESSOR=kiro.
KIRO_API_KEY=

# Use an absolute path for systemd if kiro-cli is not on the service PATH.
KIRO_CLI_PATH=kiro-cli
KIRO_AGENT_NAME=market-event-classifier
KIRO_TIMEOUT_SECONDS=60

# Durable live worker state and polling.
MARKET_EVENT_DATABASE=data/processing.sqlite3
MARKET_EVENT_POLL_SECONDS=60
# Optional safety filter. Empty means every listed-company disclosure.
MARKET_EVENT_SYMBOLS=005930
# Kiro workspace containing .kiro/agents/.
MARKET_EVENT_WORKDIR=

# stock-market gateway event ingest endpoint.
STOCK_MARKET_EVENT_URL=http://127.0.0.1:8000/api/v1/events/
STOCK_MARKET_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO
